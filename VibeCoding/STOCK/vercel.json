{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/vite"
    },
    {
      "src": "api/analyze.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/analyze",
      "dest": "/api/analyze.js"
    },
    {
      "src": "/api/naver/(.*)",
      "dest": "https://polling.finance.naver.com/api/realtime/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
