{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/naver/(.*)",
      "destination": "https://polling.finance.naver.com/api/realtime/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
