{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/naver/(.*)",
      "dest": "https://polling.finance.naver.com/api/realtime/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
